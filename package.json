{
  "name": "interview-knowledge-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,yellow \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "model:start": "bash scripts/start-question-model.sh",
    "db:init": "tsx scripts/init-db.ts",
    "db:ingest": "tsx scripts/ingest-knowledge.ts",
    "db:ingest:bm25": "tsx scripts/ingest-knowledge.ts --bm25-only",
    "review": "ocr review --audience agent",
    "review:preview": "ocr review --preview",
    "review:delegate": "ocr delegate preview",
    "review:rules": "ocr delegate rule",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "lucide-react": "^0.539.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@alibaba-group/open-code-review": "^1.9.2",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
